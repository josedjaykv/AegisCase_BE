      "sourceRoot": "apps/evidence-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/evidence-service/tsconfig.app.json"
      }
    },
    "task-service": {
      "type": "application",
      "root": "apps/task-service",
      "entryFile": "main",
      "sourceRoot": "apps/task-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/task-service/tsconfig.app.json"
      }
    },
    "media-service": {
      "type": "application",
