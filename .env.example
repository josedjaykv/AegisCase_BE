# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=aegiscase
DB_PASSWORD=aegiscase
DB_NAME=aegiscase
DB_LOGGING=false
DB_SSL=false

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aegiscase
RABBITMQ_PASSWORD=aegiscase
RABBITMQ_VHOST=aegiscase
RABBITMQ_MGMT_PORT=15672
# Computed URL used by services:
RABBITMQ_URL=amqp://aegiscase:aegiscase@localhost:5672/aegiscase

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1h

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aegiscase
KEYCLOAK_CLIENT_ID=aegiscase-backend
KEYCLOAK_CLIENT_SECRET=aegiscase-backend-secret
# Keycloak admin console credentials (docker-compose)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# ─── AWS S3 (Media Service) ───────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=aegiscase-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/gif,image/webp,video/mp4,audio/mpeg,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# ─── API Gateway ──────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
CASE_SERVICE_URL=http://localhost:3003
INVOLVED_SERVICE_URL=http://localhost:3004
EVIDENCE_SERVICE_URL=http://localhost:3005
TASK_SERVICE_URL=http://localhost:3006
MEDIA_SERVICE_URL=http://localhost:3007
AUDIT_SERVICE_URL=http://localhost:3008

# ─── Service Ports ────────────────────────────────────────────────────────────
GATEWAY_PORT=3000
AUTH_PORT=3001
USER_PORT=3002
CASE_PORT=3003
INVOLVED_PORT=3004
EVIDENCE_PORT=3005
TASK_PORT=3006
MEDIA_PORT=3007
AUDIT_PORT=3008
